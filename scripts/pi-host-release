#!/bin/sh
# Explicit launcher for an independently assembled host release.
set -eu
release_dir=${PI_HOST_RELEASE_DIR:-}
[ -n "$release_dir" ] || { echo "FAIL: set PI_HOST_RELEASE_DIR to an explicit immutable release directory" >&2; exit 2; }
[ -d "$release_dir" ] && [ ! -L "$release_dir" ] || { echo "FAIL: invalid release directory: $release_dir" >&2; exit 1; }
release_dir=$(CDPATH= cd -- "$release_dir" && pwd -P)
[ -f "$release_dir/.host-release.json" ] && [ ! -L "$release_dir/.host-release.json" ] && [ -f "$release_dir/SHA256SUMS" ] && [ ! -L "$release_dir/SHA256SUMS" ] || { echo "FAIL: release provenance/checksum files missing or symlinked" >&2; exit 1; }
command -v sha256sum >/dev/null 2>&1 || { echo "FAIL: sha256sum is required" >&2; exit 1; }
expected_manifest=${PI_HOST_RELEASE_EXPECTED_MANIFEST_SHA256:-}
case "$expected_manifest" in
	[0-9a-fA-F][0-9a-fA-F]*) [ "${#expected_manifest}" -eq 64 ] || { echo "FAIL: expected manifest digest must be 64 hex characters" >&2; exit 2; } ;;
	*) echo "FAIL: set PI_HOST_RELEASE_EXPECTED_MANIFEST_SHA256 to the independently supplied manifest SHA-256" >&2; exit 2 ;;
esac
case "$expected_manifest" in *[!0-9a-fA-F]*) echo "FAIL: expected manifest digest is not hexadecimal" >&2; exit 2;; esac
actual_manifest=$(sha256sum "$release_dir/.host-release.json" | awk '{print $1}')
[ "$(printf '%s' "$actual_manifest" | tr 'A-F' 'a-f')" = "$(printf '%s' "$expected_manifest" | tr 'A-F' 'a-f')" ] || { echo "FAIL: release manifest digest mismatch" >&2; exit 1; }
[ -z "$(find "$release_dir" -type l -print -quit)" ] || { echo "FAIL: release tree contains symlinks" >&2; exit 1; }
manifest_checksums=$(node -e 'const m=require(process.argv[1]); process.stdout.write(m.checksumsSha256 || "")' "$release_dir/.host-release.json")
actual_checksums=$(sha256sum "$release_dir/SHA256SUMS" | awk '{print $1}')
[ "$manifest_checksums" = "$actual_checksums" ] || { echo "FAIL: release checksum index digest mismatch" >&2; exit 1; }
(cd "$release_dir" && sha256sum -c SHA256SUMS >/dev/null) || { echo "FAIL: release verification failed" >&2; exit 1; }
[ -x "$release_dir/dist/cli.js" ] || { echo "FAIL: release CLI missing" >&2; exit 1; }
export TMPDIR=${TMPDIR:-"$HOME/tmp"}
exec node "$release_dir/dist/cli.js" "$@"
